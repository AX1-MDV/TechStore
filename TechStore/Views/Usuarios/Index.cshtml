@model IEnumerable<UsuarioViewModel>
@using TechStore.Controllers

@{
    ViewData["Title"] = "Usuarios";
    var buscar = ViewBag.Buscar as string;
    var rolFiltro = ViewBag.Rol as string;
}

<div class="container my-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="brand-font mb-0">Usuarios</h2>
            <p class="text-muted mb-0">Administra los roles y el acceso de las cuentas.</p>
        </div>
        <span class="badge rounded-pill bg-light text-dark border fs-6">@Model.Count() usuario(s)</span>
    </div>

    @* Filtros *@
    <form method="get" class="row g-2 mb-3">
        <div class="col-12 col-md-6">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="buscar" value="@buscar" class="form-control" placeholder="Buscar por usuario o correo" />
            </div>
        </div>
        <div class="col-8 col-md-3">
            <select name="rol" class="form-select">
                <option value="">Todos los roles</option>
                @foreach (var r in UsuariosController.RolesDisponibles)
                {
                    <option value="@r" selected="@(r == rolFiltro)">@r</option>
                }
            </select>
        </div>
        <div class="col-4 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-auth flex-grow-1">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Usuario</th>
                        <th class="d-none d-md-table-cell">Correo</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No hay usuarios que coincidan con los filtros.</td>
                        </tr>
                    }
                    @foreach (var u in Model)
                    {
                        var badgeRol = u.Rol switch
                        {
                            "Administrador" => "bg-danger",
                            "Vendedor" => "bg-primary",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td>
                                <span class="fw-semibold">@u.NombreUsuario</span>
                                @if (u.EsUsuarioActual)
                                {
                                    <span class="badge bg-light text-dark border ms-1">Tú</span>
                                }
                                <div class="small text-muted d-md-none">@u.Email</div>
                            </td>
                            <td class="d-none d-md-table-cell">@u.Email</td>
                            <td>
                                @if (u.EsUsuarioActual)
                                {
                                    <span class="badge @badgeRol">@u.Rol</span>
                                }
                                else
                                {
                                    @* Cambio de rol: se envía al seleccionar un rol diferente *@
                                    <form asp-action="CambiarRol" asp-route-id="@u.Id" method="post" class="d-flex gap-1">
                                        <select name="rol" class="form-select form-select-sm rol-select" aria-label="Rol de @u.NombreUsuario">
                                            @foreach (var r in UsuariosController.RolesDisponibles)
                                            {
                                                <option value="@r" selected="@(r == u.Rol)">@r</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Guardar rol"><i class="bi bi-check-lg"></i></button>
                                    </form>
                                }
                            </td>
                            <td>
                                @if (u.Bloqueado)
                                {
                                    <span class="badge bg-danger-subtle text-danger-emphasis"><i class="bi bi-lock-fill"></i> Bloqueado</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis"><i class="bi bi-check-circle"></i> Activo</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (!u.EsUsuarioActual)
                                {
                                    if (u.Bloqueado)
                                    {
                                        <form asp-action="Desbloquear" asp-route-id="@u.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-unlock"></i> <span class="d-none d-lg-inline">Desbloquear</span></button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Bloquear" asp-route-id="@u.Id" method="post" class="d-inline swal-confirm-form"
                                              data-swal-title="¿Bloquear a @u.NombreUsuario?"
                                              data-swal-text="No podrá iniciar sesión hasta que lo desbloquees."
                                              data-swal-confirm="Sí, bloquear">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-lock"></i> <span class="d-none d-lg-inline">Bloquear</span></button>
                                        </form>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
