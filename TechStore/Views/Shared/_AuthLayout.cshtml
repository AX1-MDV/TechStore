@*
    Layout de pantalla completa para Login y Registro (sin navbar ni footer).
    El formulario ocupa media pantalla y el panel de marca la otra mitad:
    a la derecha en Login y a la izquierda en Registro.
*@
@{
    var modo = ViewData["AuthMode"] as string ?? "login";
    var esLogin = modo == "login";
    var kicker = esLogin ? "TechStore · Tecnología a tu alcance" : "Únete a TechStore";
    var titulo = esLogin
        ? "Lo último en tecnología, a un clic de distancia."
        : "Crea tu cuenta y empieza a comprar lo que te apasiona.";
    var successMessage = TempData["SuccessMessage"] as string ?? string.Empty;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Zen+Dots&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-shell @(esLogin ? "auth-shell--login" : "auth-shell--registro")">
        <a asp-controller="Home" asp-action="Index" class="auth-back">
            <i class="bi bi-arrow-left"></i> <span>Volver a la tienda</span>
        </a>

        <section class="auth-form-side">
            @RenderBody()
        </section>

        <aside class="auth-panel" aria-hidden="true">
            @* Manchas de color difuminadas: el "degradado" del panel *@
            <span class="auth-blob auth-blob--1"></span>
            <span class="auth-blob auth-blob--2"></span>
            <span class="auth-blob auth-blob--3"></span>
            <span class="auth-blob auth-blob--4"></span>
            <span class="auth-panel-fade"></span>

            <div class="auth-panel-content">
                <div class="auth-brand">
                    <span class="auth-brand-logo"><i class="bi bi-cpu"></i></span>
                    <div>
                        <p class="auth-brand-name">TechStore</p>
                        <p class="auth-brand-sub">Tienda de tecnología</p>
                    </div>
                </div>

                <div class="auth-panel-text">
                    <p class="auth-panel-kicker">@kicker</p>
                    <p class="auth-panel-title">@titulo</p>
                    <p class="auth-panel-footer">2026 © TechStore - Programación Web II</p>
                </div>
            </div>
        </aside>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (function () {
            // Mensaje de éxito (por ejemplo, "Cuenta creada correctamente").
            var success = @Json.Serialize(successMessage);
            if (success) {
                Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: success,
                            showConfirmButton: false, timer: 3500, timerProgressBar: true });
            }

            // Botones para mostrar u ocultar la contraseña.
            document.querySelectorAll('[data-toggle-password]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = document.getElementById(btn.dataset.togglePassword);
                    var mostrar = input.type === 'password';
                    input.type = mostrar ? 'text' : 'password';
                    btn.setAttribute('aria-label', mostrar ? 'Ocultar contraseña' : 'Mostrar contraseña');
                    btn.querySelector('i').className = mostrar ? 'bi bi-eye-slash' : 'bi bi-eye';
                });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
