@model TechStore.Models.HeroSectionViewModel;

<div class="container rounded-4 bg-black text-white hero-section">
    <div class="row">
        <div class="col-lg-4 d-flex flex-column align-items-start justify-content-evenly">
            <h1 class="brand-font">@Model.Title</h1>
            <p class="hero-description">
                @Model.Description
            </p>
            <a class="btn btn-secondary d-flex flex-row gap-2" asp-area="" asp-controller="@Model.CtaController" asp-action="@Model.CtaAction">
                <span>@Model.CtaText</span>
                <i class="bi bi-arrow-right text-black"></i>
            </a>
        </div>
        <div class="col-lg-8 d-flex align-items-end justify-content-center">
            <img class="img-fluid hero-img" src="@Model.HeroImageSrc" alt="@Model.Title" />
        </div>
    </div>
</div>
