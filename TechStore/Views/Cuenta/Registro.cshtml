@model RegistroViewModel

@{
    ViewData["Title"] = "Crear cuenta";
    ViewData["AuthMode"] = "registro";
    Layout = "_AuthLayout";
}

<div class="auth-form">
    <h1 class="auth-title">Crea tu cuenta</h1>
    <p class="auth-subtitle">Regístrate para comprar en TechStore.</p>

    <form asp-controller="Cuenta" asp-action="Registro" method="post" novalidate>
        @* Errores del servidor: usuario o correo repetido, contraseña débil, etc. *@
        <div asp-validation-summary="ModelOnly" class="auth-summary"></div>

        <div class="auth-fields">
            <div>
                <label asp-for="NombreUsuario" class="auth-label"></label>
                <input asp-for="NombreUsuario" class="auth-input" autocomplete="username"
                       placeholder="Ej. juanperez" autofocus />
                <span asp-validation-for="NombreUsuario" class="auth-error"></span>
            </div>

            <div>
                <label asp-for="Email" class="auth-label"></label>
                <input asp-for="Email" class="auth-input" autocomplete="email" placeholder="correo@ejemplo.com" />
                <span asp-validation-for="Email" class="auth-error"></span>
            </div>

            <div>
                <label asp-for="Password" class="auth-label"></label>
                <div class="auth-input-wrap">
                    <input asp-for="Password" class="auth-input auth-input--password"
                           autocomplete="new-password" placeholder="Crea una contraseña" />
                    <button type="button" class="auth-eye" data-toggle-password="Password" aria-label="Mostrar contraseña">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="auth-error"></span>
                <p class="auth-hint">Mínimo 6 caracteres, con mayúscula, minúscula, número y símbolo.</p>
            </div>

            <div>
                <label asp-for="ConfirmarPassword" class="auth-label"></label>
                <div class="auth-input-wrap">
                    <input asp-for="ConfirmarPassword" class="auth-input auth-input--password"
                           autocomplete="new-password" placeholder="Repite la contraseña" />
                    <button type="button" class="auth-eye" data-toggle-password="ConfirmarPassword" aria-label="Mostrar contraseña">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmarPassword" class="auth-error"></span>
            </div>

            <button type="submit" class="auth-btn">Crear cuenta</button>
        </div>
    </form>

    <p class="auth-switch">
        ¿Ya tienes una cuenta?
        <a asp-controller="Cuenta" asp-action="Login" class="auth-link">Ingresar</a>
    </p>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
