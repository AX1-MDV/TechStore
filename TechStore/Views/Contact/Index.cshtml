@{
    ViewData["Title"] = "Contáctenos";
}

<div class="d-flex flex-column gap-5">

    @await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
    {
        Title = "Contáctenos",
        Subtitle = "¿Tienes una duda o quieres más información? Escríbenos, con gusto te ayudamos.",
        Icon = "bi-headset"
    })

    <section class="container">
        <div class="row g-4">

            <div class="col-lg-7">
                <div class="contact-form-card">
                    <h2 class="brand-font mb-4">Envíanos un mensaje</h2>

                    <div id="contactSuccessAlert" class="alert alert-success d-none" role="alert">
                        ¡Gracias! Tu mensaje fue registrado. Este formulario es una demostración y no envía
                        correos reales.
                    </div>

                    <form id="contactForm" novalidate>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="fullName" class="form-label">Nombre completo</label>
                                <input type="text" class="form-control" id="fullName" name="fullName" required>
                            </div>
                            <div class="col-md-6">
                                <label for="email" class="form-label">Correo electrónico</label>
                                <input type="email" class="form-control" id="email" name="email" required>
                            </div>
                            <div class="col-12">
                                <label for="subject" class="form-label">Asunto</label>
                                <input type="text" class="form-control" id="subject" name="subject" required>
                            </div>
                            <div class="col-12">
                                <label for="message" class="form-label">Mensaje</label>
                                <textarea class="form-control" id="message" name="message" rows="5" required></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-dark d-flex flex-row align-items-center gap-2">
                                    <span>Enviar mensaje</span>
                                    <i class="bi bi-send"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="contact-info-card text-white rounded-4 h-100">
                    <h2 class="brand-font mb-4">Información de contacto</h2>
                    <address class="d-flex flex-column gap-4 mb-0">
                        <div class="d-flex flex-row align-items-start gap-3">
                            <i class="bi bi-geo-alt-fill contact-info-icon"></i>
                            <span>Av. Tecnológica 123, San Salvador, El Salvador</span>
                        </div>
                        <div class="d-flex flex-row align-items-start gap-3">
                            <i class="bi bi-telephone-fill contact-info-icon"></i>
                            <span>+503 2222-3333</span>
                        </div>
                        <div class="d-flex flex-row align-items-start gap-3">
                            <i class="bi bi-envelope-fill contact-info-icon"></i>
                            <span>contacto@techstore.com</span>
                        </div>
                        <div class="d-flex flex-row align-items-start gap-3">
                            <i class="bi bi-clock-fill contact-info-icon"></i>
                            <span>Lunes a sábado, 9:00 a.m. - 6:00 p.m.</span>
                        </div>
                    </address>
                </div>
            </div>

        </div>
    </section>

</div>

@section Scripts {
    <script>
        document.getElementById('contactForm').addEventListener('submit', function (event) {
            event.preventDefault();

            if (!this.checkValidity()) {
                this.classList.add('was-validated');
                return;
            }

            document.getElementById('contactSuccessAlert').classList.remove('d-none');
            this.reset();
            this.classList.remove('was-validated');
        });
    </script>
}
