@model IEnumerable<TechStore.Models.CardViewModel>;

@{
    ViewData["Title"] = "Inicio";
}

<div class="d-flex flex-column gap-5">
    @await Html.PartialAsync("_HeroSection", new HeroSectionViewModel
    {
        Title = "Nuevo ingreso de laptops Gamer",
        Description = "Domina cada fotograma con nuestra nueva gama de portátiles para videojuegos, equipados con GPU de última generación, frecuencias de actualización ultrarrápidas y un sistema de refrigeración avanzado diseñado para ofrecer el máximo rendimiento.",
        CtaText = "Explorar nuevos modelos",
        CtaAction = "Index",
        CtaController = "Products",
        HeroImageSrc = "/images/asus_laptops_hero.png"
    })

    <div class="container">
        <div class="row text-center">
            <h2 class="">Productos destacados</h2>
        </div>
        <div class="row mt-2">
            <div class="d-flex flex-row gap-4 overflow-x-auto py-3">
                @foreach (var product in Model)
                {
                    @await Html.PartialAsync("_PopularProductCard", product)
                }
            </div>
        </div>
    </div>

    <div class="container d-flex flex-column gap-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center">
            <div class="text-center text-md-start">
                <h4>¿No encuentras lo que buscas?</h4>
                <p>Dale un vistazo a nuestra página de categorías</p>
            </div>

            <div>
                <a class="btn btn-primary d-flex flex-row gap-2 rounded-5 w-100 w-md-auto" asp-area="" asp-controller="Categories" asp-action="Index">
                    <span>Categorías</span>
                    <i class="bi bi-arrow-right text-white"></i>
                </a>
            </div>
        </div>

        <div>
            <hr />
        </div>
    </div>


    <div class="container py-2 py-md-5 d-flex flex-column justify-content-center align-items-center gap-3 gap-md-5">
        <div class="row text-center">
            <h2 class="presentation-title">Innovación al alcance de tu mano</h2>
        </div>
        <div class="text-center px-0 px-md-5">
            <p>
                En nuestra tienda nos apasiona la tecnología que transforma tu día a día. Nos especializamos en seleccionar lo mejor en hardware de alto rendimiento, componentes de última generación, computación y dispositivos inteligentes para gaming, trabajo profesional y entretenimiento.
            </p>

            <p>Trabajamos directamente con las marcas líderes de la industria para ofrecerte productos 100% originales, garantía oficial y el asesoramiento experto que necesitas para elegir el equipo perfecto.</p>

        </div>
        <div class="w-100 d-flex flex-column flex-md-row gap-3 align-items-center justify-content-center">
            <a class="btn btn-primary w-100 w-md-auto rounded-3" asp-area="" asp-controller="Contact" asp-action="Index">
                Contáctanos
            </a>
            <a class="btn btn-secondary w-100 w-md-auto rounded-3" asp-area="" asp-controller="About" asp-action="Index">
                Conoce más sobre nosotros
            </a>
        </div>
    </div>
</div>